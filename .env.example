# ─────────────────────────────────────────────────────────────
# PostgreSQL — required. Copy this file to `.env` and fill it in,
# then run `npm run db:migrate`. Restart `npm run dev` after editing.
#
# These two have NO `VITE_` prefix on purpose: that prefix is what
# tells Vite to inline a value into the browser bundle, and the
# database URL and signing secret must never reach the browser.
# ─────────────────────────────────────────────────────────────

# Local:    postgres://postgres:postgres@localhost:5432/iotify
# Hosted:   the connection string from Neon / Supabase / Railway /
#           Vercel Postgres (TLS is negotiated automatically).
DATABASE_URL=

# Signs the admin session tokens. Any random string of 32+ characters.
# Generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
# Changing it signs everyone out.
JWT_SECRET=

# Set to `disable` only when connecting to a database that has no TLS
# and isn't on localhost. Leave blank otherwise.
# PGSSLMODE=

# ─────────────────────────────────────────────────────────────
# Student accounts.
#
# Comma-separated domains allowed to hold a student account.
# Subdomains are matched too, so `mitsgwalior.in` also accepts
# `student.mitsgwalior.in`. Defaults to mitsgwalior.in.
# ─────────────────────────────────────────────────────────────
# STUDENT_EMAIL_DOMAINS=mitsgwalior.in

# ─────────────────────────────────────────────────────────────
# Server-side email — required for one-time codes.
#
# This is NOT the EmailJS block below. EmailJS sends from the
# browser, which is fine for an approval notice but cannot carry
# a login code: anything the browser can send, it can also read.
#
# Leave RESEND_API_KEY blank in development and codes are printed
# to the `npm run dev` terminal instead of being sent. In
# production a blank key is refused rather than logged.
# https://resend.com/api-keys
# ─────────────────────────────────────────────────────────────
RESEND_API_KEY=
MAIL_FROM="IoTify Lab <onboarding@resend.dev>"

# ─────────────────────────────────────────────────────────────
# EmailJS — optional. Leave blank to disable status emails; the
# portal will silently skip sending instead of erroring.
# https://dashboard.emailjs.com/
# ─────────────────────────────────────────────────────────────
VITE_EMAILJS_SERVICE_ID=
VITE_EMAILJS_PUBLIC_KEY=
VITE_EMAILJS_TEMPLATE_APPROVED=
VITE_EMAILJS_TEMPLATE_REJECTED=
